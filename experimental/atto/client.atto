// AttoLang transport-neutral SDK surface; no implicit network capability.
// Conforms to clients/rust/src/lib.rs (health/config/events/alerts).
// expect-exit: 42
define class ApmeClient as
  constructor() {}

  pub health_path(): string { return "/healthz"; }
  pub config_path(): string { return "/api/config"; }
  pub events_path(): string { return "/api/events"; }
  pub alerts_path(): string { return "/api/alerts"; }

  pub health_method(): string { return "GET"; }
  pub config_method(): string { return "GET"; }
  pub events_method(): string { return "POST"; }
  pub alerts_method(): string { return "POST"; }
end

pub fnc main(): int {
  val client = new ApmeClient();
  if client.health_path() eq "/healthz",
     client.config_path() eq "/api/config",
     client.events_path() eq "/api/events",
     client.alerts_path() eq "/api/alerts",
     client.health_method() eq "GET",
     client.config_method() eq "GET",
     client.events_method() eq "POST",
     client.alerts_method() eq "POST" then
    return 42;
  fi
  return 0;
}
